{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "scan-events",
  "description": "Allow the main window to receive library events, save reader state before close, and control fullscreen.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen", "core:event:allow-unlisten",
    "core:window:allow-destroy", "core:window:allow-set-fullscreen", "core:window:allow-is-fullscreen"
  ]
}
